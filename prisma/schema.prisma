// Klara — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth.js (NextAuth) standard models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  products Product[]
  recipes  Recipe[]
  meals    Meal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Klara domain ----------

/// A food product the user logs (e.g. "Skyr Sancor", "Salsa Chipotle Heinz").
/// All macros are stored per 100g; actual portions are computed at log time.
model Product {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  brand String?

  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float

  /// Optional "one portion" hint in grams (or ml — treated equivalently).
  /// Comes from the nutrition label's "porción sugerida" / serving size.
  suggestedPortionGrams Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeIngredients RecipeIngredient[]
  mealEntries       MealEntry[]

  @@index([userId])
}

/// A user-defined recipe (e.g. "banana bread") composed of ingredients from
/// the user's Product library. Totals are denormalized — recomputed on save
/// from the ingredients — so the list view doesn't have to join + sum.
model Recipe {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  portions Int

  totalKcal    Float
  totalProtein Float
  totalCarbs   Float
  totalFat     Float

  ingredients RecipeIngredient[]
  mealEntries MealEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A single line in a recipe. Stores its own snapshot of macros — that
/// way edits or deletions of a referenced Product don't silently change
/// past recipes. `productId` is an optional traceability hint when the
/// ingredient came from the user's library.
model RecipeIngredient {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name  String
  grams Float

  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float

  @@index([recipeId])
  @@index([productId])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  PREWORKOUT
  OTHER
}

/// One meal logged on a specific day — breakfast, lunch, etc. Holds one
/// or more entries (each entry is a food + grams).
model Meal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date  DateTime @db.Date
  type  MealType
  notes String?

  entries MealEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

/// A single food line logged inside a meal. Per-100g macros are stored
/// as a snapshot so editing or deleting the source product/recipe later
/// doesn't silently change the user's history. The optional FKs are
/// traceability hints only — they go to NULL on source delete.
model MealEntry {
  id     String @id @default(cuid())
  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  recipeId  String?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  name  String
  grams Float

  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float

  createdAt DateTime @default(now())

  @@index([mealId])
  @@index([productId])
  @@index([recipeId])
}
