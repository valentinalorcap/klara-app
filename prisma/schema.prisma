// Klara — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth.js (NextAuth) standard models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  /// Daily nutrition goals — null until the user sets them in Settings.
  /// The Today summary renders progress rings against these values.
  dailyKcalGoal    Float?
  dailyProteinGoal Float?
  dailyCarbsGoal   Float?
  dailyFatGoal     Float?

  /// Tone Klara uses when evaluating each meal. Settings page lets the
  /// user switch between direct, motivational, or neutral.
  defaultEvalTone EvalTone @default(MOTIVATIONAL)

  /// When the first-run onboarding was completed (or skipped). Null means
  /// the user hasn't been onboarded yet → the app sends them to /welcome.
  onboardedAt DateTime?

  accounts      Account[]
  sessions      Session[]
  products      Product[]
  recipes       Recipe[]
  meals         Meal[]
  mealTemplates MealTemplate[]
  aiEvaluations AIEvaluation[]
  dayEvaluations DayEvaluation[]
  chatMessages  ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Klara domain ----------

/// A food product the user logs (e.g. "Skyr Sancor", "Salsa Chipotle Heinz").
/// All macros are stored per 100g; actual portions are computed at log time.
model Product {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  brand String?

  /// Iconify icon name from the curated palette (e.g. "tabler:egg").
  /// Set by Claude during label scan; null products fall back to a
  /// keyword map / generic icon at render time. See src/lib/productIcons.ts.
  icon String?

  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float

  /// Optional "one portion" hint in grams (or ml — treated equivalently).
  /// Comes from the nutrition label's "porción sugerida" / serving size.
  suggestedPortionGrams Float?

  /// "Currently using" marker — the product the user is actively buying.
  /// When free-text mentions an ambiguous food (e.g. "yogurt") and several
  /// products match, the in-use one wins, so Klara uses its exact macros.
  inUse Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeIngredients   RecipeIngredient[]
  mealEntries         MealEntry[]
  mealTemplateEntries MealTemplateEntry[]

  @@index([userId])
}

/// A user-defined recipe (e.g. "banana bread") composed of ingredients from
/// the user's Product library. Totals are denormalized — recomputed on save
/// from the ingredients — so the list view doesn't have to join + sum.
model Recipe {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  portions Int

  totalKcal    Float
  totalProtein Float
  totalCarbs   Float
  totalFat     Float

  /// Optional final cooked weight. If set, per-100g macros for logging
  /// are computed from this, not the raw ingredient grams sum. Reflects
  /// what the food actually weighs after baking / cooking down.
  totalGrams Float?

  /// Optional default portion size in grams. When the recipe is added
  /// to a meal, the entry's grams field auto-fills with this value.
  suggestedPortionGrams Float?

  ingredients         RecipeIngredient[]
  mealEntries         MealEntry[]
  mealTemplateEntries MealTemplateEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A single line in a recipe. Stores its own snapshot of macros — that
/// way edits or deletions of a referenced Product don't silently change
/// past recipes. `productId` is an optional traceability hint when the
/// ingredient came from the user's library.
model RecipeIngredient {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name  String
  grams Float

  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float

  @@index([recipeId])
  @@index([productId])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  PREWORKOUT
  OTHER
}

enum EvalTone {
  DIRECT
  MOTIVATIONAL
  NEUTRAL
}

enum EvalStatus {
  PENDING
  DONE
  ERROR
}

enum ChatRole {
  USER
  ASSISTANT
}

/// One turn in the user's conversation with Klara. Single continuous
/// thread per user — older messages get capped at the API layer; the
/// row itself is kept for history.
model ChatMessage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role    ChatRole
  content String   @db.Text

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// One meal logged on a specific day — breakfast, lunch, etc. Holds one
/// or more entries (each entry is a food + grams).
model Meal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime @db.Date
  type MealType

  /// User-chosen label for this meal. Most days will leave it blank; the
  /// UI falls back to the type label.
  name String?

  /// Optional link to the favorite template this meal was either logged
  /// from or that was created by starring it. Null means "no longer a
  /// favorite" — the template was removed without touching this row.
  templateId String?
  template   MealTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// When the user logs several meals in one session (Phase 7 batch),
  /// every meal in the batch shares the same opaque id. Only the last
  /// meal of the batch carries the AIEvaluation row — its prompt sees
  /// all siblings as context.
  batchId String?

  notes String?

  entries    MealEntry[]
  evaluation AIEvaluation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([templateId])
  @@index([batchId])
}

/// A saved favorite — a snapshot of a meal's ingredients the user can
/// reuse to seed a future log. Independent from Meal rows, so deleting a
/// past meal doesn't disturb the favorite.
model MealTemplate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type MealType
  name String?

  entries MealTemplateEntry[]
  meals   Meal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model MealTemplateEntry {
  id         String       @id @default(cuid())
  templateId String
  template   MealTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  recipeId  String?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  name  String
  grams Float

  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float

  @@index([templateId])
  @@index([productId])
  @@index([recipeId])
}

/// Klara's per-meal evaluation. One row per meal — re-running the eval
/// (e.g. after the user edits the meal) overwrites this row. Status moves
/// PENDING → DONE on success, or PENDING → ERROR if Anthropic fails; the
/// UI shows a skeleton for PENDING and a retry button for ERROR.
model AIEvaluation {
  id     String @id @default(cuid())
  mealId String @unique
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tone   EvalTone
  status EvalStatus @default(PENDING)

  /// Final markdown shown in the card. Null until status = DONE.
  markdown String?

  /// Surfaced under the retry button when status = ERROR.
  errorMessage String?

  model     String?
  tokensIn  Int?
  tokensOut Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Klara's holistic evaluation of a whole day, generated when the user
/// "finishes" the day. One per (user, date); re-finishing overwrites it.
model DayEvaluation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The day this evaluation covers (UTC midnight, like Meal.date).
  date DateTime @db.Date

  tone   EvalTone
  status EvalStatus @default(PENDING)

  /// Final text shown in the card. Null until status = DONE.
  markdown String?
  /// Surfaced when status = ERROR.
  errorMessage String?

  model     String?
  tokensIn  Int?
  tokensOut Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/// A single food line logged inside a meal. Per-100g macros are stored
/// as a snapshot so editing or deleting the source product/recipe later
/// doesn't silently change the user's history. The optional FKs are
/// traceability hints only — they go to NULL on source delete.
model MealEntry {
  id     String @id @default(cuid())
  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  recipeId  String?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  name  String
  grams Float

  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float

  createdAt DateTime @default(now())

  @@index([mealId])
  @@index([productId])
  @@index([recipeId])
}
