# Copia este archivo como `.env` y completa con tus valores reales.
# El `.env` NUNCA se commitea (está en .gitignore).

# Neon Postgres
DATABASE_URL=""   # Pooled connection (tiene "-pooler" en el hostname)
DIRECT_URL=""     # Direct connection (sin "-pooler")

# Auth.js v5
AUTH_SECRET=""    # generar con: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Anthropic Claude API
ANTHROPIC_API_KEY=""
